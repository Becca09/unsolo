# =============================================================================
# Unsolo — Environment Variables (Phase A — Foundation)
# =============================================================================
# Copy this file to .env.local (per-app override) or .env and fill in values.
# NEVER commit real secrets. See docs/environments.md for how dev/staging/
# production configuration is structured.
#
# NOTE: No values below are assumed/invented — placeholders only. Some
# providers (Nigerian payment provider, AI provider) are intentionally left
# generic per the architecture decisions in docs/architecture-proposal.md.
# =============================================================================

# --- General ---------------------------------------------------------------
NODE_ENV=development
APP_ENV=development

# --- apps/web (Next.js) -----------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_MAPBOX_TOKEN=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# --- apps/api (NestJS) -------------------------------------------------------
PORT=4000
CORS_ORIGIN=http://localhost:3000

# Supabase (server-side; service role key must never reach the frontend)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

# Database (Supabase Postgres, via Drizzle)
DATABASE_URL=postgresql://user:password@localhost:5432/unsolo

# Rate limiting
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# --- Payments -----------------------------------------------------------------
# International provider (Stripe). Nigerian provider env vars will be added
# behind the same PaymentProvider abstraction once selected — see
# apps/api/src/modules/payments/application/payment-provider.interface.ts
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=

# --- Background jobs (Inngest) ----------------------------------------------
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# --- Maps (Mapbox) -----------------------------------------------------------
MAPBOX_ACCESS_TOKEN=

# --- Email (Resend) -----------------------------------------------------------
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# --- Analytics (PostHog) -------------------------------------------------------
POSTHOG_API_KEY=
POSTHOG_HOST=https://app.posthog.com

# --- AI (provider intentionally not selected yet) -----------------------------
# AI_PROVIDER=
# AI_API_KEY=
